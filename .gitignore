# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but the template belongs in version control
!.env.example

# Supabase CLI scratch state — records which project this machine is linked to
supabase/.temp/

# YOLO weights for the dashcam sidecar — copied onto the box by
# deploy/setup-detector.sh, not carried in every clone (28 MB).
detector/models/*.pt
detector/models/*.onnx
