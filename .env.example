# Copy this file to `.env.local` and fill it in. Restart `npm run dev` after.
#
# For the face / number-plate redaction feature you only need ONE value:
#
#   GEMINI_API_KEY=<paste your key here>       (free student key: aistudio.google.com/apikey)
#
# Without it the app still runs, but the Report tab blocks filing until you
# manually cover any faces / plates and tick a confirmation.
#
# The Supabase values below are needed for the app to boot at all.
#   Dashboard -> Project Settings -> API

# Project API URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable / anon key. Safe to expose to the browser: every table is
# protected by owner-scoped RLS, so this key alone reads nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where sandboxed complaint mail is routed. Never a real .gov.in address.
DEMO_INBOX=demo-inbox@civicagent.local

# --- Real email round-trip (auto-send complaints, auto-handle replies) --------
# The app's own account. Complaints are sent FROM here and its inbox is polled
# for authority replies. Gmail needs 2FA + a 16-char App Password (not the
# normal password): https://myaccount.google.com/apppasswords
GMAIL_USER=nammachennaidev@gmail.com
GMAIL_APP_PASSWORD=

# For the demo, ALL authority mail is routed here so a human can play the
# authority, reply, and watch the backend react. The real role-based address
# stays visible as `intendedTo` in the Outbox; this is only `actuallyTo`.
DEMO_AUTHORITY_EMAIL=aravind54006@gmail.com

# Server-only. Lets the inbound webhook read/write a report it has no user
# session for. NEVER expose to the browser (no NEXT_PUBLIC_ prefix). Use the
# SECRET key (starts with `sb_secret_`), NOT the publishable one.
#   Supabase Dashboard -> Settings -> API Keys -> Secret keys
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding /api/inbound/poll so only our own client/cron can
# trigger an inbox sweep. Any long random string.
INBOUND_POLL_SECRET=

# Optional but load-bearing for privacy. One Gemini vision call on the Report tab
# returns category + severity AND the face / number-plate boxes to redact — there
# is no on-device detector any more. WITHOUT A KEY the app still works: the
# citizen picks the category, and the Report tab BLOCKS filing until they have
# covered any faces / plates by hand and ticked a confirmation (it will not imply
# a photo is clean). The WhatsApp intake and tracking-link verify redact
# server-side from the same call.
#
# Free tier: ~1,500 calls/day, no credit card.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override. Defaults to gemini-3.6-flash.
#
# NOT 2.5-flash any more: Google now 404s it for newly-issued API keys with
# "This model is no longer available to new users". If verification suddenly
# starts refusing with `vision_error`, check the server log for a Gemini 404
# before suspecting the photo.
#
# Also note the free tier is rate-limited to ~5 requests PER MINUTE on 3.6-flash
# (not per day). One report costs up to three calls — classify at intake, route
# if it falls outside the Chennai ward polygons, and verify the after-photo — so
# a rapid demo or a full `npm run verify:whatsapp` run can trip it. A 429 is
# surfaced honestly as "our image check is busy", never as a closed report.
# GEMINI_MODEL=gemini-3.6-flash

# --- Namma Chennai X/Twitter posting (hybrid) --------------------------------
# Optional. When ALL four are set, escalations/updates post to a real X account
# via the X v2 API. Absent -> posts are simulated and shown only in the in-app
# "Namma Chennai" timeline. Real posting needs an X developer app with write
# access (a paid tier) and OAuth 1.0a user tokens.
#   https://developer.x.com -> Project/App -> Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Bluesky posting (free alternative to X — no API credits needed) ----------
# Create a Bluesky account, then Settings -> App Passwords -> Add App Password.
# postSocial() prefers Bluesky when these are set. Identifier is the handle
# (e.g. nammachennai.bsky.social); password is the generated app password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Dashcam mode (pothole detection over an uploaded drive video) needs no
# config — it runs a YOLOv8n model from public/models via onnxruntime-web,
# entirely client-side, fetched from our own origin on first use and then
# browser-cached. No API key, no env var.

# --- WhatsApp intake (Twilio Sandbox) ----------------------------------------
# Optional. When set, citizens can file a report by sending a photo and then a
# location pin to the Twilio WhatsApp Sandbox number, and get back a public
# tracking link. WITHOUT THESE the webhook replies that intake isn't configured
# and the rest of the app is unaffected.
#
# Setup (about five minutes):
#   1. Twilio Console -> Messaging -> Try it out -> Send a WhatsApp message.
#      Activate the sandbox; note the join keyword.
#   2. Sandbox settings -> "When a message comes in":
#        https://<your-deployment>/api/whatsapp/inbound   (POST)
#   3. From your phone, WhatsApp "join <keyword>" to +1 415 523 8886.
# The sandbox session expires 3 days after joining — rejoin before a demo.
#
# Console -> Account Info. The auth token also signs every webhook, and
# /api/whatsapp/inbound REJECTS requests whose X-Twilio-Signature doesn't
# verify — it is a public endpoint that writes to the database and sends mail,
# so this is the only thing standing in front of it. Never expose it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional override. Twilio signs the URL exactly as configured above, so if
# this app sits behind a tunnel or rewrite where the incoming request's own URL
# doesn't match (ngrok, a proxy that changes the host), set the configured URL
# here verbatim or signature checks will fail.
# TWILIO_WEBHOOK_URL=

# The sender for OUTBOUND notifications — the message telling a citizen that an
# authority claims their report is fixed, that its deadline passed, or that it
# escalated. Defaults to the Twilio Sandbox number, which is the same for every
# account, so leave it unset while on the sandbox.
#
# READ THIS BEFORE EXPECTING NOTIFICATIONS TO ARRIVE. WhatsApp only allows a
# freeform business message within 24 HOURS of the citizen's last inbound
# message. Outside that window Twilio rejects the send with error 63016 and the
# only way through is a message template pre-approved by Meta. In practice:
#   claims_done  — usually delivers (the conversation is normally still warm)
#   past_sla     — usually does NOT (it falls due days later)
#   escalated    — usually does NOT
# Failures are recorded on whatsapp_notifications.delivery_error rather than
# hidden, and the tracking link has no such limit. This is a WhatsApp platform
# rule, not something the app can route around.
# TWILIO_WHATSAPP_FROM=+14155238886

# Absolute base for the tracking links sent over WhatsApp. Falls back to
# VERCEL_URL on Vercel, then http://localhost:3000. Set it in production so
# links point at your real domain rather than a per-deployment URL.
PUBLIC_BASE_URL=
