# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API

# Project API URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable / anon key. Safe to expose to the browser: every table is
# protected by owner-scoped RLS, so this key alone reads nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where sandboxed complaint mail is routed. Never a real .gov.in address.
DEMO_INBOX=demo-inbox@civicagent.local

# --- Real email round-trip (auto-send complaints, auto-handle replies) --------
# The app's own account. Complaints are sent FROM here and its inbox is polled
# for authority replies. Gmail needs 2FA + a 16-char App Password (not the
# normal password): https://myaccount.google.com/apppasswords
GMAIL_USER=nammachennaidev@gmail.com
GMAIL_APP_PASSWORD=

# For the demo, ALL authority mail is routed here so a human can play the
# authority, reply, and watch the backend react. The real role-based address
# stays visible as `intendedTo` in the Outbox; this is only `actuallyTo`.
DEMO_AUTHORITY_EMAIL=aravind54006@gmail.com

# Server-only. Lets the inbound webhook read/write a report it has no user
# session for. NEVER expose to the browser (no NEXT_PUBLIC_ prefix). Use the
# SECRET key (starts with `sb_secret_`), NOT the publishable one.
#   Supabase Dashboard -> Settings -> API Keys -> Secret keys
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding /api/inbound/poll so only our own client/cron can
# trigger an inbox sweep. Any long random string.
INBOUND_POLL_SECRET=

# Optional. Enables automatic issue identification on the Report tab via a
# Gemini vision call. WITHOUT IT THE APP STILL WORKS — /api/classify reports
# itself unconfigured and the citizen picks the category, which is the honest
# fallback rather than a weak guess.
#
# Free tier: ~1,500 classifications/day, no credit card.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override. Defaults to gemini-2.5-flash (stable, multimodal, free tier).
# GEMINI_MODEL=gemini-2.5-flash

# --- Namma Chennai X/Twitter posting (hybrid) --------------------------------
# Optional. When ALL four are set, escalations/updates post to a real X account
# via the X v2 API. Absent -> posts are simulated and shown only in the in-app
# "Namma Chennai" timeline. Real posting needs an X developer app with write
# access (a paid tier) and OAuth 1.0a user tokens.
#   https://developer.x.com -> Project/App -> Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Bluesky posting (free alternative to X — no API credits needed) ----------
# Create a Bluesky account, then Settings -> App Passwords -> Add App Password.
# postSocial() prefers Bluesky when these are set. Identifier is the handle
# (e.g. nammachennai.bsky.social); password is the generated app password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# --- Dashcam mode (client-side pothole detection) ----------------------------
# Optional. Enables real-time pothole bounding boxes during Dashcam mode via
# Roboflow's inferencejs SDK, which runs a trained detection model entirely in
# the browser (WebGL) — no server round trip per frame. WITHOUT IT THE TAB
# STILL OPENS but shows "Dashcam detection isn't configured" and disables
# video upload — the same honest fallback as GEMINI_API_KEY above.
#
# Free Roboflow account -> Settings -> API Keys -> Publishable Key. Safe to
# expose to the browser: it only authorizes loading a public model's weights.
NEXT_PUBLIC_ROBOFLOW_API_KEY=

# Format "<model-slug>/<version>", copied straight from a model's Roboflow
# Universe page (e.g. browse https://universe.roboflow.com/search?q=class:pothole).
# Verify the exact class label and real-world accuracy via that page's
# "Try Model" widget before relying on it for a live demo.
NEXT_PUBLIC_ROBOFLOW_MODEL=
